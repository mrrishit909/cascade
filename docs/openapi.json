{
 "openapi": "3.1.0",
 "info": {
  "title": "CASCADE API",
  "version": "1.0.0",
  "description": "Synthetic semiconductor wafer/die demo data."
 },
 "paths": {
  "/v1/wafer": {
   "get": {
    "summary": "List dies with yield"
   }
  },
  "/v1/die/cells": {
   "get": {
    "summary": "Cell grid for the representative die"
   }
  },
  "/v1/log": {
   "get": {
    "summary": "Fab log"
   }
  },
  "/v1/log/{id}/notes": {
   "post": {
    "summary": "Add a note; requires Idempotency-Key"
   }
  },
  "/v1/wafer/scan": {
   "get": {
    "summary": "WebSocket: replays the wafer scan die by die (query speed=1..60)"
   }
  }
 }
}